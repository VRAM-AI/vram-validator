# VRAM Validator — Environment Variables
# Copy to .env and fill in your wallet mnemonic.

# ── Sui Wallet ────────────────────────────────────────────────────────────────
VRAMHUB_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Testnet RPC + Contract IDs (v0.7 · deployed 2026-06-09) ──────────────────
VRAMHUB_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
VRAMHUB_PACKAGE_ID=0xaff18bf6286047126901610d758d8fd111c9215a6e46abc704b6a0be838badd5
VRAMHUB_PEER_REGISTRY_ID=0x50a9982f6a3d6c1e6674f0fb4fa8b985007dbe19fc797abc691579be1f6493df
VRAMHUB_VALIDATOR_REGISTRY_ID=0x438d0ce63d40210d4e621cca6aaaf5d5438adaa54dfd71383fe41a82692a2561
VRAMHUB_ENCLAVE_REGISTRY_ID=0x442b82e471c1ee4577ea1f2168deb1f0b04fcc861ab79edb4b9c7d7738bf7f9f
VRAMHUB_SCORE_LEDGER_ID=0x0d2594727abeb45a13763baf8801ae765fbe41d147b28916ca78a0d08f73223a
VRAMHUB_ROUND_STATE_ID=0xc1f18dc92629907641bc3176449af39738d2d8a93b4ad6b22548f4aed91d2611
VRAMHUB_HPARAMS_ID=0x18b884530033f9b3e449b898c540ee5d3a25c4cab0abcf4843ef8e86e12adbfc
VRAMHUB_REWARD_POOL_ID=0x576ebeb78449ad46ef70dc3c5ca4e38d178846610bd7cf9f0764ae2f1dc0fe93

# ── Storage backend ───────────────────────────────────────────────────────────
# Walrus is free on testnet — no account or credentials needed.
VRAMHUB_STORAGE_BACKEND=walrus
VRAMHUB_DEMO_MODE=true      # no encryption on testnet; use VRAMHUB_AES_FALLBACK_KEY for mainnet
# VRAMHUB_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# VRAMHUB_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# ── Validator ─────────────────────────────────────────────────────────────────
# Set to 0 for first run. After vram-cli register-validator, update with your UID.
VRAMHUB_VALIDATOR_UID=0
VRAMHUB_NAUTILUS_URL=http://localhost:3000

# ── Seal IBE Key Servers ──────────────────────────────────────────────────────
VRAMHUB_SEAL_KEY_SERVER_IDS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0xf5d14a81a982144ae441cd7d64b09027f116a468bd36e7eca494f750591623c8
VRAMHUB_SEAL_THRESHOLD=2
VRAMHUB_SKIP_SEAL=true

# ── Mode ──────────────────────────────────────────────────────────────────────
# TEST_MODE=true  → testnet / simulated scoring / no Nitro enclave required
# TEST_MODE=false → production, requires AWS Nitro EC2 + register-enclave
#
# The binary reads SLCL_ prefix for mode flags; set both to be safe.
VRAMHUB_TEST_MODE=true
SLCL_TEST_MODE=true

# ── Nitro Enclave (production only) ──────────────────────────────────────────
VRAMHUB_NITRO_ENCLAVE=false
SLCL_NITRO_ENCLAVE=false
VRAMHUB_ENCLAVE_PUBKEY=
VRAMHUB_ENCLAVE_OBJECT_ID=
